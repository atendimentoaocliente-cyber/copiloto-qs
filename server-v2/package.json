{
  "name": "copiloto-qs-gateway",
  "version": "2.0.0",
  "private": true,
  "description": "Gateway de produção do Copiloto QS — ponte áudio→Deepgram→motor de sugestões→QS (Grupo Inovvatur)",
  "type": "module",
  "engines": {
    "node": ">=20.11 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cobertura": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit",
    "embeddings:backfill": "tsx --env-file=.env scripts/backfill-embeddings.ts",
    "smoke": "tsx scripts/smoke-ws.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.12.4",
    "pgvector": "^0.3.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "ws": "^8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
