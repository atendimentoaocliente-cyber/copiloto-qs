# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Transcrição (Deepgram) ──────────────────────────────────────────────────
# VALIDADO EM PRODUÇÃO: language=pt-BR NÃO funciona (nova-2 devolve nada,
# nova-3 decodifica português como inglês). Use nova-3 + multi.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
STT_PROVEDOR=deepgram

# ─── IA (Anthropic) ──────────────────────────────────────────────────────────
# Sem a chave, o gateway roda só com L0 (gatilhos) + L1 (banco). Nunca trava.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CLASSIFICADOR=claude-haiku-4-5
ANTHROPIC_MODEL_GERADOR=claude-sonnet-5
ANTHROPIC_MODEL_RESUMO=claude-sonnet-5

# ─── Embeddings (busca vetorial L1) ──────────────────────────────────────────
# O schema da Frente A fixa vector(1536) + text-embedding-3-small.
# Endpoint compatível com o formato OpenAI /v1/embeddings.
EMBEDDINGS_API_KEY=
EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSOES=1536

# ─── Banco (Supabase Postgres, pooler em modo transação, porta 6543) ─────────
# DB_MODO=memoria roda sem banco (dev local / testes). Em produção: postgres.
DB_MODO=postgres
DATABASE_URL=postgresql://postgres.SEU_PROJECT_ID:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ─── Autenticação ────────────────────────────────────────────────────────────
# Segredo do JWT que o gateway emite para a extensão (>= 32 chars aleatórios).
JWT_SEGREDO=troque-por-32-ou-mais-caracteres-aleatorios
JWT_TTL=12h
PAIRING_TTL_SEGUNDOS=300
# Caminho oficial: o QS manda o access_token do Supabase Auth (Frente A).
SUPABASE_JWT_SECRET=
# Caminho transitório (QS ainda sem Supabase Auth): aceita e-mail+senha de qs_users.
PAIRING_ACEITA_SENHA_LEGADA=false
# Origens permitidas no WebSocket. ID fixo da extensão (chave no manifest).
EXTENSAO_ORIGENS=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
# Origem do QS para CORS nas rotas REST
QS_ORIGEM=https://qs.inovvatur.com.br

# ─── Custo e limites ─────────────────────────────────────────────────────────
CAMBIO_BRL=5.40
CUSTO_MAX_BRL_POR_CALL=25
SESSAO_MAX_MINUTOS=120
SESSOES_MAX_POR_CLOSER=2
DRENAGEM_MAX_MS=2700000
PLAYBOOK_CACHE_SEGUNDOS=300

# ─── Observabilidade / interno ───────────────────────────────────────────────
# Se definidos, /metrics e /internal/* exigem "Authorization: Bearer <token>".
METRICS_TOKEN=
INTERNAL_TOKEN=
